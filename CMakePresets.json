{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "POOL_ENABLE_CCACHE": "ON",
        "POOL_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (asserts, sanitizers off)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g3"
      }
    },
    {
      "name": "dev",
      "displayName": "Developer default",
      "inherits": "debug",
      "cacheVariables": {
        "POOL_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG"
      }
    },
    {
      "name": "asan",
      "displayName": "Address + UB sanitizers",
      "inherits": "debug",
      "cacheVariables": {
        "POOL_SANITIZE": "address,undefined",
        "POOL_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "ubsan",
      "displayName": "Undefined-behaviour sanitizer only",
      "inherits": "debug",
      "cacheVariables": {
        "POOL_SANITIZE": "undefined",
        "POOL_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage (clang source-based)",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O0 -g --coverage -fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage -fprofile-instr-generate"
      }
    },
    {
      "name": "ci",
      "displayName": "CI (warnings are errors)",
      "inherits": "release",
      "cacheVariables": {
        "POOL_WARNINGS_AS_ERRORS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "ci", "configurePreset": "ci" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug",
      "execution": { "jobs": 0 }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "configurePreset": "ubsan"
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage"
    },
    {
      "name": "ci",
      "inherits": "base",
      "configurePreset": "ci"
    }
  ],
  "workflowPresets": [
    {
      "name": "check",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    }
  ]
}
